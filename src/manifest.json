{
  "manifest_version": 3,
  "name": "BS Helper",
  "version": "1.0.0",
  "description": "Study assistant for D2L Brightspace: ask questions about your course materials with AI.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.brightspace.com/*",
    "*://*/*d2l/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.brightspace.com/*",
        "*://*/*d2l/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "assets/content-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "test-page/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "BS Helper (Alt+B)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Toggle BS Helper"
    }
  }
}
