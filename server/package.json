{
  "name": "brightspace-ai-helper-server",
  "version": "0.1.0",
  "private": true,
  "description": "API gateway for the Brightspace AI Helper extension: auth, limits, usage ledger, AI provider adapters",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
