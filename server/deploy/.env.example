# Copy to ~/app/.env on the server (chmod 600) and fill in. Never commit the real file.

# Public hostname that points to the VPS (A record), e.g. mijnnaam.duckdns.org
DOMAIN=bshelper.duckdns.org
PUBLIC_URL=https://bshelper.duckdns.org

# Generate with:  openssl rand -base64 48
AUTH_SECRET=

# AI provider: gemini | anthropic | mistral
PROVIDER=gemini
MODEL=gemini-3.1-flash-lite
PROVIDER_API_KEY=
# Optional: EU processing for Mistral (billed at 1.1x):  PROVIDER_BASE_URL=https://api.eu.mistral.ai
# Optional: Gemini thinking budget in tokens (0 = off); thinking tokens are billed as output
GEMINI_THINKING_BUDGET=0
# Conversion used to book costs in euros. Check the current rate occasionally.
USD_TO_EUR=0.92

# Outgoing mail for sign-up codes (any SMTP provider). Brevo: smtp://<smtp-login>:<smtp-key>@smtp-relay.brevo.com:587
# (URL-encode special characters in the key; MAIL_FROM must be a sender verified in Brevo)
SMTP_URL=
MAIL_FROM=BS Helper <no-reply@example.com>

# Limits (defaults shown)
# Anyone can sign in, but only emails you approve (cli: email:allow <email>) can use the AI: they get
# USER_DAILY_EUR per day and nothing more (no weekly or monthly cap). Everyone else has a budget of 0.
USER_DAILY_EUR=0.25
GLOBAL_DAILY_EUR=2
USER_RPM=10
USER_CONCURRENCY=2
MAX_INPUT_TOKENS=120000
MAX_OUTPUT_TOKENS=8192
# Lowest extension version allowed to call the API
MIN_CLIENT_VERSION=0.0.0
