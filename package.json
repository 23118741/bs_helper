{
  "name": "bs-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Manifest V3 Browser Extension for D2L Brightspace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && VITE_BUILD_TARGET=production vite build",
    "build:all": "npm run build && npm run build:dev",
    "build:dev": "tsc --noEmit && VITE_DEV_DIRECT_GEMINI=1 vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:prod": "tsc --noEmit && VITE_BUILD_TARGET=production vite build",
    "build:local": "tsc --noEmit && vite build",
    "release": "bash scripts/release.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
